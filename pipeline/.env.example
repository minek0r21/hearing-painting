# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 저장소에 올리지 않는다.

# Hugging Face 토큰 (필수): Stable Audio 3 medium은 모델 페이지에서 사용 동의를 해야 받을 수 있다.
# https://huggingface.co/stabilityai/stable-audio-3-medium → 동의 → https://huggingface.co/settings/tokens 에서 Read 토큰 발급
HF_TOKEN=

# Gemini API 키 (선택): 답지 만들기와 품질 채점에 쓴다. 비워 두면 채점 없이 소리 묶음만 만든다.
# 평가 스크립트(eval_baseline.py, eval_newset.py)의 채점에는 필요하다.
GEMINI_API_KEY=
